/*--------------------------------*- C++ -*----------------------------------*\
  f1-aero-simulation : simplified 2026 car, half model (Y >= 0)
  Template: cfd/templates/car_half, filled in by scripts/make_cfd_case.py
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}

simulationType  RAS;

RAS
{
    RASModel        kOmegaSST;
    turbulence      on;
    printCoeffs     on;
}
