#!/bin/bash
# Mesh + solve the half-car case, recording wall time per step (log.timing) and the
# resident memory of this run's own processes every 2 s (log.mem, MB; valid on shared
# nodes too). Re-running skips finished steps.
cd "$(dirname "$0")" || exit 1
[ -n "$WM_PROJECT_DIR" ] || { echo "OpenFOAM environment not loaded"; exit 1; }

NP=$(foamDictionary -entry numberOfSubdomains -value system/decomposeParDict)

ROOT_PID=$$
echo "# rss_mb of all descendants of Allrun" >> log.mem
( while :; do
    rss=$(ps -eo pid=,ppid=,rss= | awk -v root=$ROOT_PID '
        {p[$1]=$2; r[$1]=$3}
        END {s=0; for (i in p) {j=i; n=0; while (j>1 && j!=root && n<50) {j=p[j]; n++} if (j==root) s+=r[i]} print int(s/1024)}')
    echo "$(date +%s.%N) $rss" >> log.mem; sleep 2
  done ) &
SAMPLER=$!
trap 'kill $SAMPLER 2>/dev/null' EXIT

step() {   # step <name> <command...> ; skipped when log.<name> already ends cleanly
    local name=$1; shift
    if [ -f "log.$name" ] && grep -q "^End" "log.$name"; then
        echo "skip $name (log.$name complete)"; return 0
    fi
    echo "$name start $(date +%s.%N)" >> log.timing
    echo "running $name ..."
    "$@" > "log.$name" 2>&1
    local rc=$?
    echo "$name end $(date +%s.%N) rc=$rc" >> log.timing
    if [ $rc -ne 0 ]; then echo "step $name failed, see log.$name"; exit $rc; fi
}
par() { mpirun -np "$NP" "$@" -parallel; }

step surfaceFeatureExtract surfaceFeatureExtract
step blockMesh             blockMesh
step decomposePar          decomposePar -force
step snappyHexMesh         par snappyHexMesh -overwrite
step checkMesh             par checkMesh -constant

if [ ! -d processor0/0 ]; then
    for d in processor*; do cp -r 0.orig "$d/0"; done
fi
step potentialFoam         par potentialFoam -writephi
step simpleFoam            par simpleFoam
