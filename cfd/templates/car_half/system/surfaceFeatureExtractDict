/*--------------------------------*- C++ -*----------------------------------*\
  f1-aero-simulation : simplified 2026 car, half model (Y >= 0)
  Template: cfd/templates/car_half, filled in by scripts/make_cfd_case.py
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaceFeatureExtractDict;
}

_feature
{
    extractionMethod    extractFromSurface;
    includedAngle       150;    // keep edges sharper than 30 deg
    subsetFeatures
    {
        nonManifoldEdges    no;
        openEdges           yes;
    }
    writeObj            no;
}

body.stl            { $_feature; }
front_wing.stl      { $_feature; }
rear_wing.stl       { $_feature; }
wheels_front.stl    { $_feature; }
wheels_rear.stl     { $_feature; }
@EXTRA_FEATURE_FILES@

#remove _feature
