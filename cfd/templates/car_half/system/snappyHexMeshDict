/*--------------------------------*- C++ -*----------------------------------*\
  f1-aero-simulation : simplified 2026 car, half model (Y >= 0)
  Template: cfd/templates/car_half, filled in by scripts/make_cfd_case.py
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       @ADD_LAYERS@;

geometry
{
    body.stl         { type triSurfaceMesh; name body; }
    front_wing.stl   { type triSurfaceMesh; name front_wing; }
    rear_wing.stl    { type triSurfaceMesh; name rear_wing; }
    wheels_front.stl { type triSurfaceMesh; name wheels_front; }
    wheels_rear.stl  { type triSurfaceMesh; name wheels_rear; }

    wakeBox { type box; min (-2.0 0 0);  max (10.0 1.4 1.6); }    // car + near wake
    nearBox { type box; min (-1.5 0 0);  max (5.0 1.1 1.3); }     // around the car
    wingBox { type box; min (-1.35 0 0); max (-0.35 0.75 0.45); } // front-wing slots
}

castellatedMeshControls
{
    maxLocalCells       3000000;
    maxGlobalCells      30000000;
    minRefinementCells  10;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 3;

    features
    (
        { file "body.eMesh";         level @LV_BODY_MAX@; }
        { file "front_wing.eMesh";   level @LV_WING_MAX@; }
        { file "rear_wing.eMesh";    level @LV_WING_MAX@; }
        { file "wheels_front.eMesh"; level @LV_BODY_MIN@; }
        { file "wheels_rear.eMesh";  level @LV_BODY_MIN@; }
    );

    refinementSurfaces
    {
        body
        {
            level (@LV_BODY_MIN@ @LV_BODY_MAX@);
            patchInfo { type wall; inGroups (car); }
        }
        "(front_wing|rear_wing)"
        {
            level (@LV_WING_MIN@ @LV_WING_MAX@);
            patchInfo { type wall; inGroups (car); }
        }
        "wheels_.*"
        {
            level (@LV_BODY_MIN@ @LV_BODY_MIN@);
            patchInfo { type wall; inGroups (car wheels); }
        }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
        wakeBox { mode inside; levels ((1E15 @LV_WAKE@)); }
        nearBox { mode inside; levels ((1E15 @LV_NEAR@)); }
        wingBox { mode inside; levels ((1E15 @LV_WINGBOX@)); }
    }

    locationInMesh (-4.9871 2.5137 2.5311);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch        3;
    tolerance           2.0;
    nSolveIter          50;
    nRelaxIter          5;
    nFeatureSnapIter    10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes       true;
    layers
    {
        "(body|front_wing|rear_wing|wheels_.*)" { nSurfaceLayers @N_LAYERS@; }
    }
    expansionRatio      1.2;
    finalLayerThickness 0.5;
    minThickness        0.1;
    nGrow               0;
    featureAngle        60;
    slipFeatureAngle    30;
    nRelaxIter          3;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle  90;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;
}

meshQualityControls
{
    #include "meshQualityDict"
    nSmoothScale    4;
    errorReduction  0.75;
}

mergeTolerance 1e-6;
